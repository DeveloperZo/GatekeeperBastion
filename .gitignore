# OS
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Agent and tooling output at the repo root. These are the transcripts and
# reports an editor batch leaves behind (M35 produced a dozen). They are
# evidence for one session, not project history — the session log in Logs/ is
# the record, and it is already ignored above.
# ---------------------------------------------------------------------------
/gkb_*.log
/gkb_*.json
/bastion_ui_assemble.log
/*_report.json
/*_report.prev.json

# Unity Test Runner PlayMode bootstrap scenes. Created per run, deleted on
# teardown; leftovers are not project history.
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta

# Scratch and staging directories. _to_delete/ exists because a connected
# folder cannot be deleted through the device bridge — files are moved here
# and removed by hand.
/_backup/
/_to_delete/

# One-shot editor scripts run from Assets/_Scratch/ and are removed before the next
# verify gate (Tools/verify/run.sh fails while the folder holds anything but
# .gitkeep). The folder itself stays tracked — .gitkeep and Assets/_Scratch.meta —
# so Unity keeps a stable GUID for it.
Assets/_Scratch/*
!Assets/_Scratch/.gitkeep

# Harness output, if GKB_HARNESS_OUT is ever pointed inside the repo.
/gkb-harness/

# Skill eval output and the baseline-run staging dir. Generated per run, never history.
.claude/skills/_evals/results/
.claude/skills/_evals/.hidden/
.claude/skills/_evals/raw_stream.jsonl
.claude/skills/_evals/stderr.txt

# Local UPM tarball staging and embedded copies of registry packages. Never commit;
# the lock file + PackageCache are the install. These folders exist only while the
# editor is being unblocked.
/_upm_tmp/
/Packages/com.unity.burst/
/Packages/com.unity.collections/
/Packages/com.unity.mathematics/
/Packages/com.unity.multiplayer.playmode/
/Packages/com.unity.netcode.gameobjects/
/Packages/com.unity.nuget.mono-cecil/
/Packages/com.unity.properties/
/Packages/com.unity.test-framework.performance/
/Packages/com.unity.transport/

# Asset Store vendor dumps. Project-owned wrappers stay in Assets/Packs/.
# Reimport from the SKU recorded in Docs/Decisions.md; .meta GUIDs in the
# store package must match the wrappers. Commit Assets/Synty.meta so the
# folder GUID is stable on a clone before the pack is imported.
/Assets/Synty/
