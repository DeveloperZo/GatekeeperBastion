# VS Code / Cursor: share only the files.exclude that keeps the root readable.
# Unity regenerates *.csproj / *.slnx at the project root on open; they are not source.
.vscode/*
!.vscode/settings.json

# Cursor — rules are shared, local CLI state is not.
.cursor/cli.json

# Unity crash reports / profiling
sysinfo.txt
crashlytics-build.properties
*.stackdump

# Builds / packages
*.apk
*.aab
*.unitypackage
*.app

# OS
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Agent and tooling output at the repo root. These are the transcripts and
# reports an editor batch leaves behind (M35 produced a dozen). They are
# evidence for one session, not project history — the session log in Logs/ is
# the record, and it is already ignored above.
# ---------------------------------------------------------------------------
/Captures/
/gkb_*.log
/gkb_*.json
/gkb_*.txt
/gkb_*.md
/bastion_ui_assemble.log
/*_report.json
/*_report.prev.json
/*_batch.log
/GameplayCapture_*.mp4
/ShipFlythrough.mp4
/*.mp4

# Discarded one-shot handoffs. Delete when empty; never commit.
/_m61_2_handoff/
/_skill_updates/
/_wp4_author_park/
/_stage_snap/

# Unity Test Runner PlayMode bootstrap scenes. Created per run, deleted on
# teardown; leftovers are not project history.
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta

# Scratch and staging directories. _to_delete/ exists because a connected
# folder cannot be deleted through the device bridge — files are moved here
# and removed by hand.
/_backup/
/_to_delete/
/Docs/_to_delete/

# One-shot editor scripts run from Assets/_Scratch/ and are removed before the next
# verify gate (Tools/verify/run.sh fails while the folder holds anything but
# .gitkeep). The folder itself stays tracked — .gitkeep and Assets/_Scratch.meta —
# so Unity keeps a stable GUID for it.
Assets/_Scratch/*
!Assets/_Scratch/.gitkeep

# Harness output, if GKB_HARNESS_OUT is ever pointed inside the repo.
/gkb-harness/

# Local audio analysis / loop-cut scratch (ffmpeg, spectrograms).
/Tools/_audio-scratch/

# Skill eval output and the baseline-run staging dir. Generated per run, never history.
.claude/skills/_evals/results/
.claude/skills/_evals/.hidden/
.claude/skills/_evals/raw_stream.jsonl
.claude/skills/_evals/stderr.txt

# Local secrets — never commit. Service-account keys for Unity Cloud stay outside git.
Docs/_meta/unity.env
Docs/_meta/*.env
*.env.local

# Local UPM tarball staging and embedded copies of registry packages. Never commit;
# the lock file + PackageCache are the install. These folders exist only while the
# editor is being unblocked.
/_upm_tmp/
/Packages/com.unity.burst/
/Packages/com.unity.collections/
/Packages/com.unity.mathematics/
/Packages/com.unity.multiplayer.playmode/
/Packages/com.unity.netcode.gameobjects/
/Packages/com.unity.nuget.mono-cecil/
/Packages/com.unity.properties/
/Packages/com.unity.test-framework.performance/
/Packages/com.unity.transport/

# Asset Store vendor dumps. Project-owned wrappers stay in Assets/Packs/.
# Reimport from the SKU recorded in Docs/Decisions.md; .meta GUIDs in the
# store package must match the wrappers. Commit Assets/Synty.meta so the
# folder GUID is stable on a clone before the pack is imported.
/Assets/Synty/
# FaxLab3D Sci-Fi robots + Shooter Weapons (candidates; not yet wrapped).
# Keep Assets/FaxLab3D.meta tracked for a stable folder GUID on clone.
#
# Exception to the vendor-dump rule, added 2026-08-19: the pack's 24 materials and
# its texture .meta files ARE tracked. They carry hand edits this project depends on
# — every material moved off the pack's URP-only ShaderGraph onto Built-In Standard,
# and the four *_Emissive.png import as colour rather than Single Channel so the
# gatekeeper materials in Packs/ get their glow. Both are invisible to git while the
# dump is ignored, and a re-import silently reverts them. Tracking the text makes a
# re-import show up as a diff instead of as a bug. The 534MB of textures, models,
# scenes and the nested .unitypackage stay out. See M88.
/Assets/FaxLab3D/*
!/Assets/FaxLab3D/SciFiRobotCharactersPack/
/Assets/FaxLab3D/SciFiRobotCharactersPack/*
!/Assets/FaxLab3D/SciFiRobotCharactersPack/Materials/
!/Assets/FaxLab3D/SciFiRobotCharactersPack/Textures/
/Assets/FaxLab3D/SciFiRobotCharactersPack/Textures/*
!/Assets/FaxLab3D/SciFiRobotCharactersPack/Textures/*.meta
/Assets/Packs/shooterweaponspackassets/
/Assets/Packs/shooterweaponspackassets.meta
# weapon_source narrowed 2026-08-19, same exception as FaxLab3D above: the
# Packs/Weapons wrapper prefabs now reference these GUIDs, so the .meta files
# (GUIDs, externalObjects material remaps, globalScale=100), the hand-made
# materials in mat/ and the README ARE tracked. The binary fbx/png payload
# stays out — restore it from Downloads/shooterweaponspackassets.zip per the
# folder README.
/Assets/Packs/weapon_source/*
!/Assets/Packs/weapon_source/*.meta
!/Assets/Packs/weapon_source/README.md
!/Assets/Packs/weapon_source/mat/
!/Assets/Packs/weapon_source/tex/
/Assets/Packs/weapon_source/tex/*
!/Assets/Packs/weapon_source/tex/*.meta

# Python bytecode caches from Tools/ lint scripts. Three .pyc files were tracked before
# this rule existed; a rule does not untrack them, so they still need a git rm --cached.
__pycache__/
*.pyc
